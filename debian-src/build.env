# === Script settings ===

DEBIAN_ARCHES=(amd64 arm64)

if [[ -z "${DEBIAN_MAINTAINER}" ]]; then
	DEBIAN_MAINTAINER="$(git config user.name) <$(git config user.email)>"
fi

RUST_TRIPLES=(x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu)

# === Environment variables ===

RUST_TOOLCHAIN="stable"

CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="x86_64-linux-gnu-gcc"
CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER="aarch64-linux-gnu-gcc"

HELIX_DISABLE_AUTO_GRAMMAR_BUILD="1" # Grammars can't be fetched if github is down :(
